    // ----- DOM refs -----
    const container = document.getElementById('cardsContainer');
    const searchInput = document.getElementById('searchInput');
    const searchButton = document.getElementById('searchButton');
    const filterBtns = document.querySelectorAll('.filter-btn');

    let currentFilter = 'todos';
    let currentSearch = '';

    // ----- render cards -----
    function render() {
      const filtered = unidades.filter(item => {
        // distrito
        if (currentFilter !== 'todos' && item.distrito !== currentFilter) return false;
        // search (nome, endereco, telefones, email)
        if (currentSearch.trim() !== '') {
          const q = currentSearch.trim().toLowerCase();
          const nomeMatch = item.nome.toLowerCase().includes(q);
          const endMatch = item.endereco.toLowerCase().includes(q);
          const telMatch = item.telefones.some(t => t.toLowerCase().includes(q));
          const emailMatch = item.email.toLowerCase().includes(q);
          if (!(nomeMatch || endMatch || telMatch || emailMatch)) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="no-results">🔎 Nenhuma unidade encontrada com esse filtro ou busca.</div>`;
        return;
      }

      let html = '';
      filtered.forEach(item => {
        const telefonesHtml = item.telefones.length
          ? item.telefones.map(t => `<span>${t}</span>`).join(' ')
          : '<span style="opacity:0.6;">—</span>';

        const emailHtml = item.email
          ? `<div class="card-email">📧 <a href="mailto:${item.email}">${item.email}</a></div>`
          : '';

        const distritoLabel = item.distrito.charAt(0).toUpperCase() + item.distrito.slice(1);

        html += `
          <div class="card" data-distrito="${item.distrito}">
            <div class="card-title">${item.nome}</div>
            <div class="card-distrito">🏷️ ${distritoLabel}</div>
            <div class="card-address"><span class="icon-addr"></span> ${item.endereco}</div>
            <div class="card-phone"><span class="icon-phone"></span> ${telefonesHtml}</div>
            ${emailHtml}
          </div>
        `;
      });

      container.innerHTML = html;
    }

    // ----- filter + search triggers -----
    function applyFilterAndSearch() {
      render();
    }

    // eventos de filtro
    filterBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        filterBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentFilter = this.dataset.distrito;
        applyFilterAndSearch();
      });
    });

    // eventos de busca
    function handleSearch() {
      currentSearch = searchInput.value;
      applyFilterAndSearch();
    }

    searchButton.addEventListener('click', handleSearch);
    searchInput.addEventListener('keyup', function(e) {
      if (e.key === 'Enter') handleSearch();
    });

    // inicial
    render();
  })();
