<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contatos · Distritos Sanitários</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
    }

    body {
      background: #f5f7fc;
      padding: 2rem 1rem;
    }

    /* ===== HEADER ===== */
    .header {
      background: linear-gradient(145deg, #0b2b4a 0%, #1a3f62 100%);
      color: white;
      padding: 2rem 2rem 1.5rem 2rem;
      border-radius: 28px;
      box-shadow: 0 12px 28px rgba(0, 20, 40, 0.25);
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
    }

    .header::after {
      content: '';
      position: absolute;
      top: -30%;
      right: -10%;
      width: 280px;
      height: 280px;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 50%;
      pointer-events: none;
    }

    .header h1 {
      font-size: 1.9rem;
      font-weight: 600;
      letter-spacing: -0.5px;
      margin-bottom: 0.25rem;
    }

    .header-sub {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-top: 0.4rem;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 0.9rem;
    }

    .header-sub .org {
      font-size: 0.95rem;
      opacity: 0.85;
      line-height: 1.5;
    }

    .header-sub .org strong {
      opacity: 1;
      color: #ffd966;
    }

    .header-sub .dev {
      font-size: 0.85rem;
      background: rgba(255, 255, 255, 0.08);
      padding: 0.3rem 1rem;
      border-radius: 40px;
      backdrop-filter: blur(2px);
    }

    .header-sub .motto {
      width: 100%;
      font-style: italic;
      font-weight: 300;
      letter-spacing: 0.3px;
      font-size: 0.9rem;
      opacity: 0.8;
      margin-top: 0.25rem;
    }

    /* ===== SEARCH ===== */
    .search-wrapper {
      max-width: 700px;
      margin: 0 auto 2.5rem auto;
      background: white;
      border-radius: 60px;
      padding: 0.3rem 0.3rem 0.3rem 1.8rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
      display: flex;
      align-items: center;
      border: 1px solid #e9edf4;
      transition: box-shadow 0.25s, border-color 0.2s;
    }

    .search-wrapper:focus-within {
      box-shadow: 0 8px 24px rgba(0, 70, 150, 0.12);
      border-color: #1a3f62;
    }

    .search-wrapper input {
      border: none;
      padding: 0.9rem 0;
      font-size: 1rem;
      width: 100%;
      background: transparent;
      outline: none;
      color: #1e2a3e;
    }

    .search-wrapper input::placeholder {
      color: #9aa6b9;
      font-weight: 400;
    }

    .search-wrapper button {
      background: #0b2b4a;
      border: none;
      color: white;
      padding: 0.7rem 2.2rem;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      white-space: nowrap;
      letter-spacing: 0.4px;
    }

    .search-wrapper button:hover {
      background: #1e4b70;
    }

    .search-wrapper button:active {
      transform: scale(0.96);
    }

    /* ===== FILTER BUTTONS (distritos) ===== */
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem 1.2rem;
      justify-content: center;
      margin-bottom: 2.5rem;
      padding: 0 0.2rem;
    }

    .filter-btn {
      background: white;
      border: 1px solid #dde3ed;
      padding: 0.5rem 1.4rem;
      border-radius: 40px;
      font-weight: 500;
      font-size: 0.85rem;
      color: #1e2a3e;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
      letter-spacing: 0.3px;
    }

    .filter-btn:hover {
      border-color: #1a3f62;
      background: #f0f5ff;
      transform: translateY(-1px);
    }

    .filter-btn.active {
      background: #0b2b4a;
      border-color: #0b2b4a;
      color: white;
      box-shadow: 0 6px 12px rgba(11, 43, 74, 0.18);
    }

    /* ===== CARDS GRID ===== */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.8rem;
      max-width: 1600px;
      margin: 0 auto;
    }

    .card {
      background: white;
      border-radius: 24px;
      padding: 1.5rem 1.5rem 1.5rem 1.5rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.03);
      border: 1px solid #edf0f7;
      transition: transform 0.2s, box-shadow 0.25s;
      display: flex;
      flex-direction: column;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 32px rgba(0, 20, 40, 0.08);
      border-color: #d4dceb;
    }

    .card-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: #0b2b4a;
      margin-bottom: 0.6rem;
      letter-spacing: -0.3px;
      line-height: 1.3;
    }

    .card-distrito {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #1a5b7a;
      background: #e5edf8;
      display: inline-block;
      padding: 0.2rem 0.9rem;
      border-radius: 40px;
      margin-bottom: 0.8rem;
      align-self: flex-start;
      font-weight: 600;
    }

    .card-address {
      font-size: 0.95rem;
      color: #2d3a54;
      margin-bottom: 0.4rem;
      display: flex;
      align-items: baseline;
      gap: 0.3rem;
    }

    .card-address i {
      opacity: 0.6;
      margin-right: 0.2rem;
    }

    .card-phone {
      font-size: 0.95rem;
      color: #1e3b5c;
      margin: 0.25rem 0 0.2rem 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 0.8rem;
    }

    .card-phone span {
      background: #f2f6fd;
      padding: 0.1rem 0.6rem;
      border-radius: 20px;
      font-weight: 500;
    }

    .card-email {
      font-size: 0.85rem;
      color: #1a5a8c;
      word-break: break-all;
      margin-top: 0.4rem;
      background: #f8faff;
      padding: 0.3rem 0.7rem;
      border-radius: 30px;
      display: inline-block;
      border: 1px solid #e0e9f5;
    }

    .card-email a {
      color: #0b2b4a;
      text-decoration: none;
      font-weight: 500;
    }

    .card-email a:hover {
      text-decoration: underline;
    }

    .card-tag {
      margin-top: 0.6rem;
      font-size: 0.7rem;
      color: #5b6f8a;
      background: #f0f3fa;
      padding: 0.1rem 0.9rem;
      border-radius: 30px;
      align-self: flex-start;
    }

    /* ===== no results ===== */
    .no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem 0;
      color: #3a4c6b;
      font-weight: 400;
      background: #f0f4fe;
      border-radius: 60px;
      font-size: 1.1rem;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 640px) {
      .header {
        padding: 1.5rem;
      }
      .header h1 {
        font-size: 1.5rem;
      }
      .search-wrapper {
        flex-wrap: wrap;
        background: transparent;
        box-shadow: none;
        padding: 0;
        gap: 0.6rem;
      }
      .search-wrapper input {
        background: white;
        padding: 0.9rem 1.5rem;
        border-radius: 60px;
        border: 1px solid #dde3ed;
      }
      .search-wrapper button {
        width: 100%;
        justify-content: center;
        padding: 0.8rem;
      }
      .filter-bar {
        gap: 0.4rem 0.8rem;
      }
      .filter-btn {
        font-size: 0.75rem;
        padding: 0.3rem 1rem;
      }
      .cards-grid {
        grid-template-columns: 1fr;
        gap: 1.2rem;
      }
    }

    /* ícone simbólico */
    .icon-addr::before { content: "📍"; margin-right: 4px; opacity: 0.7; }
    .icon-phone::before { content: "📞"; margin-right: 4px; opacity: 0.7; }
  </style>
</head>
